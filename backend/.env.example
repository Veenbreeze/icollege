PORT=4000
DATABASE_URL=postgres://icollege:icollege@localhost:5432/icollege
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
UPLOAD_DIR=uploads
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006

# Optional: sends real password-reset-code emails via Gmail SMTP when both
# are set. Leave unset to fall back to returning the code in the API
# response (dev-only, never in production) for local testing without email.
GMAIL_USER=
GMAIL_APP_PASSWORD=
