# Optional. Leave blank to infer localhost (web) or the Expo development host (native).
# Set this only when the API is on a different host, e.g. http://192.168.1.13:4000.
EXPO_PUBLIC_API_URL=
# Set true only if you intentionally want to keep the configured URL in development
# even when it differs from the host serving Expo (for example, a separate API host).
EXPO_PUBLIC_API_URL_FORCE=false
