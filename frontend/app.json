{
  "expo": {
    "name": "iCollege",
    "slug": "iCollege",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icollege-icon.png",
    "scheme": "icollege",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icollege-icon.png",
      "supportsTablet": true
    },
    "android": {
      "package": "tz.ac.icollege.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6FAFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6FAFF",
          "image": "./assets/images/icollege-splash.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-asset",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77c18194-350e-4f24-b02a-56b6b9a3a973"
      }
    },
    "owner": "victorhq12"
  }
}
